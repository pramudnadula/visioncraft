# FaceVision Environment Configuration Example
# Copy to `.env` and customize as needed. Never commit `.env` with real secrets.

# Execution mode: local_desktop | web_local_agent | cloud
FACEVISION_EXECUTION_MODE=web_local_agent

# Server binding (keep 127.0.0.1 for local-only use; 0.0.0.0 in Docker/cloud)
FACEVISION_HOST=127.0.0.1
FACEVISION_PORT=8000

# Optional API token to protect endpoints (sent via X-FaceVision-Token or Bearer header)
FACEVISION_API_TOKEN=

# Hybrid Cloud Processing (strictly opt-in; local is default)
FACEVISION_ALLOW_CLOUD_PROCESSING=false
FACEVISION_CLOUD_API_URL=

# Storage & Database (defaults to local .facevision_data/ and SQLite)
FACEVISION_STORAGE_BACKEND=local
# FACEVISION_DATABASE_URL=postgresql+psycopg://facevision:facevision@localhost:5432/facevision

# Optional S3-compatible storage (used when FACEVISION_STORAGE_BACKEND=s3)
FACEVISION_S3_ENDPOINT_URL=
FACEVISION_S3_BUCKET=
FACEVISION_S3_REGION=us-east-1
FACEVISION_S3_ACCESS_KEY=
FACEVISION_S3_SECRET_KEY=

# Security & Processing Limits
FACEVISION_MAX_UPLOAD_SIZE_BYTES=262144000
FACEVISION_MAX_IMAGE_DIMENSION=16384
FACEVISION_MAX_VIDEO_DURATION_SECONDS=3600
FACEVISION_MAX_CONCURRENT_JOBS=2
FACEVISION_RETENTION_DAYS=30
